{{ "freeza-flavors.css" | asset_url | stylesheet_tag }}


<div class="freeza-flavors">
    <div class="container">
        <div class="sec-header">
            {% render "freeza-sec-header", sec_sub_title: "Flavor Experience", sec_title_1: "Explore The Flavors", sec_title_2: "Feel The Boom!", sec_text_1: "Every sip delivers an explosion of real fruit flavor,", sec_text_2: "ice-cold refreshment, and unstoppable energy." %}
            <div class="bg-icons">
                <div class="ice-cube_1"><img src="{{ 'ice-cube-1.png' |  asset_url }}" width="500" height="500" alt="" /></div>
                <div class="ice-cube_2"><img src="{{ 'ice-cube-2.png' |  asset_url }}" width="500" height="500" alt="" /></div>
                <div class="tree-leaf_1"><img src="{{ 'tree-leaf.png' |  asset_url }}" width="500" height="500" alt="" /></div>
                <div class="tree-leaf_2"><img src="{{ 'tree-leaf.png' |  asset_url }}" width="500" height="500" alt="" /></div>
            </div>
        </div>
        <div class="body">
            {% for block in section.blocks %}
                {% if block.settings.bg_color_type == "custom" %}
                    {%  assign bg_color = block.settings.bg_color %}
                    {% else %}
                    {%  assign bg_color = block.settings.bg_color_selected %}
                {% endif %}
                {% render "freeza-flavor-card", product_image: block.settings.product_img, product_name: block.settings.product_title, product_info: block.settings.product_info, bg_color: bg_color, shopify_attr: block.shopify_attributes, splash_img: block.settings.splash_img, fruit_chunks_1: block.settings.fruit_chunks_1, product_link: block.settings.product_link %}
            {% endfor %}
        </div>
        <div class="footer-sec-btn">
            {% render "freeza-btn",style: "primary" , text:"View All Flavors", url: section.settings.all_flavors_url, arrow: true %}
        </div>
    </div>
</div>

{% schema %}
{
    "name": "FreezaBoom Flavors",
    "settings": [
        {
            "type": "url",
            "id": "all_flavors_url",
            "label": "All Flavors Url"
        }
    ],
    "blocks": [{
        "name": "Product Card",
        "type": "flavor",
        "settings": [
            {
                "type": "image_picker",
                "id": "product_img",
                "label": "Product"
            },
            {
                "type": "text",
                "id": "product_title",
                "label": "Product Title",
                "info": "Type The Flavor"
            },
            {
                "type": "text",
                "id": "product_info",
                "label": "Product Info",
                "info": "Keep the Info Short to Keep Design Beautiful"
            },
            {
                "type": "select",
                "id": "bg_color_type",
                "label": "Background Color Source",
                "options": [
                    {
                    "value": "preset",
                    "label": "Preset Color"
                    },
                    {
                    "value": "custom",
                    "label": "Custom Color"
                    }
                ],
                "default": "preset"
            },
            {
                "type": "color",
                "id": "bg_color",
                "label": "Background Color"
            },
            {
                "type": "select",
                "id": "bg_color_selected",
                "label": "Select Background Color",
                "options": [
                    {
                        "value": "#E9F9D9",
                        "label": "Lemon"
                    },
                    {
                        "value": "#FCE3E8",
                        "label": "Watermelon"
                    },
                    {
                        "value": "#F9F6C8",
                        "label": "Mango"
                    },
                    {
                        "value": "#EEE1FA",
                        "label": "Berry"
                    }
                ],
                "default": "#E9F9D9"
            },
            {
                "type": "image_picker",
                "id": "splash_img",
                "label": "Splash Image"
            },
            {
                "type": "image_picker",
                "id": "fruit_chunks_1",
                "label": "Fruit Chunks 1"
            }, 
            {
                "type": "url",
                "id": "product_link",
                "label": "Product Link"
            }
        ],
        "limit": 4
    }],
    "presets": [{
        "name": "FreezaBoom Flavors"
    }]
}
{% endschema %}